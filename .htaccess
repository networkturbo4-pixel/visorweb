# ===================================================
# WebReview Pro - cPanel Apache Configuration
# ===================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS redirection (opcional si se activa SSL en cPanel)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Permitir cabeceras de autorización en peticiones REST
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Permitir visualización en iframes internos (necesario para el visor y pines)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' *"
</IfModule>

# Habilitar compresión Gzip para mayor velocidad
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# Denegar acceso directo a la base de datos SQLite y logs
<FilesMatch "\.(db|db-wal|db-shm|db-journal|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
